# Copy this file to .env.local (git-ignored) and edit. Used only by `npm run dev` and `npm run dev:seed`.
# `npm run dev` and `npm run dev:seed` check this file's database before use. `npm start` outside production also reads it
# without those checks, so use `npm run dev`. Production never reads a file.
# See docs/LOCAL_DEVELOPMENT.md.

# A PostgreSQL on THIS machine. The dev tools refuse Neon, Render and other managed hosts, and any non-local host.
DATABASE_URL=postgres://postgres:devpassword@127.0.0.1:55433/tableverse_dev

# Local play needs no mail service: verification is optional (the default for `npm run dev`).
REQUIRE_EMAIL_VERIFICATION=false

PORT=3000

# Do not put production values (database, Resend key, ...) in this file.
